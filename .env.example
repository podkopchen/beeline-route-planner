# Optional self-hosted OSRM endpoint; leave empty to disable runtime road routing.
ROUTING_BASE_URL=
ROUTEFLOW_ROUTE_GEOMETRY_URL=https://router.project-osrm.org
ROUTEFLOW_AUTH_ENABLED=true
ROUTEFLOW_DEMO_USERNAME=dispatcher
ROUTEFLOW_DEMO_PASSWORD=RouteFlow2026!
ROUTEFLOW_SESSION_SECRET=replace-with-at-least-32-random-characters
ROUTEFLOW_SESSION_TTL_SECONDS=28800
ROUTEFLOW_COOKIE_SECURE=false
# After self-hosted OSRM is prepared and verified: http://127.0.0.1:5000
# An .env file is documentation only; scripts/start-api.ps1 uses process environment.
